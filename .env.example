# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# App API Key — shared secret between this server and the iOS app
# Generate with: openssl rand -hex 32
# Set this in Railway dashboard; use same value in the iOS app
API_SECRET_KEY=your-generated-key-here

# Server Configuration
PORT=3000
NODE_ENV=production

# CORS Configuration
ALLOWED_ORIGINS=*

# Rate Limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=3600000

# Caching
CACHE_TTL_SECONDS=604800
